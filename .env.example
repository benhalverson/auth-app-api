# Better-Auth Configuration
# Used for local development and testing
#
# To use this file:
# 1. Copy to .dev.vars for local development
# 2. Set values appropriate for your environment

# Secret key for better-auth encryption and hashing
# Must be at least 32 characters
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-for-testing

# Database Configuration
# For Cloudflare Workers, D1 is automatically bound via wrangler.jsonc
# This is included for reference and completeness

# Base URL for authentication
# Used in email links and redirects
# BETTER_AUTH_URL=http://localhost:8787

# OAuth Providers (if configured)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Email Configuration (for verification emails)
# EMAIL_FROM=noreply@example.com
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=465
# EMAIL_USER=your-email-username
# EMAIL_PASSWORD=your-email-password
