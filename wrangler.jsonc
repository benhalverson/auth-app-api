{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "auth-app-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-24",
	"compatibility_flags": ["nodejs_compat_populate_process_env"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "users",
			"database_name": "users",
			"database_id": "9e901102-ce98-46fc-992d-818197703ad6"
		}
	]
}